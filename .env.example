# Copy this file to .env and add your NVIDIA Build API keys.
# Never put real keys in browser JavaScript or commit .env.
# NVIDIA_API_KEY is the primary key for existing installations.
NVIDIA_API_KEY=
# Optional backups. The server tries these in order when a key fails.
NVIDIA_API_KEY_2=
NVIDIA_API_KEY_3=
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Local development only; Render sets PORT automatically.
PORT=4173
# Store student accounts and learning history on a persistent volume.
# The default local path is ./data. A hosted service needs a durable DATA_DIR.
DATA_DIR=
