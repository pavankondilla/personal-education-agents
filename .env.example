# Copy this file to .env and add server-side provider API keys.
# Never put real keys in browser JavaScript or commit .env.
# NVIDIA Build (first enabled provider by default).
NVIDIA_API_KEY=
# OpenRouter key, despite its existing variable name. Uses the free Nemotron route.
NVIDIA_API_KEY_2=
# Groq API key. The legacy variable name is GROK_API_KEY_3 (not xAI Grok).
GROK_API_KEY_3=
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
GROQ_MODEL=openai/gpt-oss-120b
# Local development only; Render sets PORT automatically.
PORT=4173
# Store student accounts and learning history on a persistent volume.
# The default local path is ./data. A hosted service needs a durable DATA_DIR.
DATA_DIR=
